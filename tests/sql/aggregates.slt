# Aggregation and GROUP BY

statement ok
CREATE TABLE sales (id INTEGER PRIMARY KEY, region TEXT, product TEXT, qty INTEGER, price REAL)

query
SELECT count(*), count(qty), sum(qty), avg(qty), min(qty), max(qty) FROM sales
----
0 | 0 | NULL | NULL | NULL | NULL

query
SELECT region, count(*) FROM sales GROUP BY region
----

statement ok
INSERT INTO sales VALUES
  (1, 'north', 'apple', 10, 1.5),
  (2, 'north', 'pear', 5, 2.0),
  (3, 'south', 'apple', 7, 1.5),
  (4, 'south', 'apple', NULL, 1.75),
  (5, 'east', 'kiwi', 3, 4.0),
  (6, 'north', 'apple', 2, 1.5)

query
SELECT count(*), count(qty), sum(qty), min(price), max(product)
FROM sales
----
6 | 5 | 27 | 1.5 | pear

query
SELECT avg(qty) FROM sales
----
5.4

query
SELECT region, count(*), sum(qty) FROM sales GROUP BY region ORDER BY region
----
east | 1 | 3
north | 3 | 17
south | 2 | 7

query
SELECT region, sum(qty * price) AS revenue FROM sales GROUP BY region ORDER BY revenue DESC
----
north | 28
east | 12
south | 10.5

query
SELECT region, product, count(*) FROM sales GROUP BY region, product ORDER BY 1, 2
----
east | kiwi | 1
north | apple | 2
north | pear | 1
south | apple | 2

query
SELECT region FROM sales GROUP BY region HAVING count(*) > 1 ORDER BY region
----
north
south

query
SELECT region, count(DISTINCT product) FROM sales GROUP BY region ORDER BY region
----
east | 1
north | 2
south | 1

query
SELECT count(DISTINCT price) FROM sales
----
4

# GROUP BY an alias, a position and an expression
query
SELECT upper(region) AS r, count(*) FROM sales GROUP BY r ORDER BY r
----
EAST | 1
NORTH | 3
SOUTH | 2

query
SELECT qty > 4 AS big, count(*) FROM sales GROUP BY 1 ORDER BY 1
----
NULL | 1
false | 2
true | 3

query
SELECT region, max(qty) - min(qty) FROM sales GROUP BY region ORDER BY max(qty) DESC
----
north | 8
south | 0
east | 0

query
SELECT region, group_concat(product, '+') FROM sales WHERE region <> 'north' GROUP BY region ORDER BY region
----
east | kiwi
south | apple+apple

query
SELECT string_agg(region, ',') FROM (SELECT DISTINCT region FROM sales ORDER BY region) r
----
east,north,south

# HAVING without GROUP BY treats the table as one group
query
SELECT sum(qty) FROM sales HAVING count(*) > 100
----

query
SELECT count(*) FROM sales WHERE qty IS NULL
----
1

statement error must appear in the GROUP BY clause
SELECT region, product FROM sales GROUP BY region

statement error aggregate function count() is not allowed in WHERE
SELECT region FROM sales WHERE count(*) > 1

statement error sum() expects numbers
SELECT sum(region) FROM sales

statement error wrong number of arguments to max()
SELECT max(qty, price) FROM sales

query
SELECT region, avg(price) FROM sales GROUP BY region ORDER BY avg(price), region
----
south | 1.625
north | 1.666667
east | 4
